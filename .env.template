# AI Companion Environment Configuration
# Copy this file to .env and fill in your API keys

# Google Gemini API (Primary AI Brain) - Now using REST API
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TIMEOUT=30
GEMINI_MAX_TOKENS=1000
# GEMINI_MODEL=gemini-2.0-flash  # Latest model (default)
# GEMINI_MODEL=gemini-1.5-flash  # Alternative model

# KoboldCPP Configuration (Fallback AI Brain)
KOBOLDCPP_TIMEOUT=30
KOBOLDCPP_MAX_TOKENS=400

# Web Search APIs (Multiple Provider Support)
# Configure at least one search provider:

# Option 1: Brave Search API (Free tier: 2000 queries/month)
# Get your key from: https://api.search.brave.com/app/keys
BRAVE_SEARCH_API_KEY=your_brave_api_key_here

# Option 2: Google Custom Search API (Free tier: 100 queries/day)
# Setup instructions:
# 1. Enable Custom Search API: https://console.developers.google.com/
# 2. Create Custom Search Engine: https://cse.google.com/
# 3. Configure to search the entire web
GOOGLE_SEARCH_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_CX=your_custom_search_engine_id_here

# Optional: Model Preferences
# GEMINI_MODEL=gemini-1.5-flash  # or gemini-1.5-pro
# KOBOLDCPP_URL=http://localhost:5001  # if running on different port

# Optional: Feature Toggles
# ENABLE_VISION=true
# ENABLE_AUDIO=true
# ENABLE_SCHEDULER=true
